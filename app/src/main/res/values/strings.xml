    <!-- About -->
    <string name="section_privacy">What Barid sends and keeps</string>
    <string name="about_privacy_1">Only bank transaction messages are sent, and only to the server you connected.</string>
    <string name="about_privacy_2">One-time passwords, verification codes and messages from personal numbers never leave the phone.</string>
    <string name="about_privacy_3">Message text is kept only until it is delivered. The Recent list stores bank, amount and time, never the text.</string>
    <string name="about_privacy_4">No ads, no analytics, no Barid server. The connection key is excluded from backups.</string>
    <string name="section_open_source">Open source</string>
    <string name="about_open_source_body">Barid is free software under the GNU GPL v3.0. Anyone can read the code and check these promises.</string>
