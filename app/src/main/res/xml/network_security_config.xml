<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except plain HTTP for testing against a Darakav on the local network; the
     app warns when a connection is not encrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
